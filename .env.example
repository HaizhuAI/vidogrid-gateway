PORT=8188
HOST=0.0.0.0
ADMIN_PASSWORD=admin123
# 独立管理 Key（Bearer 直调 /admin/api/* 与 /v1/*）
# MASTER_KEY=vg-master-xxxx
# UPSTREAM_BASE=https://api.vidogrid.ai/api
# ANTIBOT_SALT=&vTQm0&u
# ANTIBOT_KEY=45NPBH$&
# REQUEST_TIMEOUT=120000
# SESSION_TTL_MS=86400000

# ---- 号池补给 / 注册机（也可在 WebUI「补给」页在线改）----
# REPL_ENABLED=1            # 开启自动补给（默认关，面板里开）
# 其余策略参数全部走 db.settings.replenisher，见 WebUI
# TEMPMAIL_HUB_URL=http://localhost:8000   # 可选：真实收件箱来源

# ---- Turnstile（免费号生成被 CF 拦时）----
# CAPSOLVER_KEY=            # 或 TWOCAPTCHA_KEY —— 打码服务
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# TURNSTILE_CDP_URL=http://127.0.0.1:9222   # 接管真实 Chrome（cf_clearance 加成）
# TURNSTILE_HEADLESS=0
# TURNSTILE_PROXY=http://127.0.0.1:7890     # 不设置则自动读系统代理
